{
  "name": "cnvlens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:og && vite build",
    "build:og": "node scripts/build-og.js",
    "build:clean": "rm -rf dist node_modules/.vite && npm run build",
    "build:wasm": "wasm-pack build --release --target web --out-dir src/wasm rust/cnvlens-core",
    "start": "node server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@unhead/vue": "^3.1.0",
    "d3": "^7.9.0",
    "plotly.js-dist-min": "^3.1.2",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.18",
    "text-to-svg": "^3.1.5",
    "vite": "^7.1.7"
  }
}
